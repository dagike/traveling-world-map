{
  "name": "traveling-world-map",
  "version": "0.0.0",
  "private": true,
  "description": "Interactive world map of the countries, cities and theme parks I've visited",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w @twm/server",
    "dev:client": "npm run dev -w @twm/client",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
