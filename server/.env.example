# Copy to server/.env and adjust as needed.
PORT=4000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173
# Postgres connection string. Use a Neon database (a dev branch for local work).
DATABASE_URL=postgres://user:password@host/dbname
# Password required to add/edit/delete data.
ADMIN_PASSWORD=admin
# Secret used to sign admin session tokens; set to a long random string.
TOKEN_SECRET=dev-insecure-secret
