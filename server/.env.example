# Copy to server/.env and adjust as needed.
PORT=4000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173
# Postgres connection string. Use a Neon database (a dev branch for local work).
# Omit any `channel_binding=require` param; keep `sslmode=require`.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Secret used to sign admin session tokens; any long random string (openssl rand -base64 32).
TOKEN_SECRET=dev-insecure-secret

# Production credential: scrypt hash from `npm run hash-password -w @twm/server -- '<pw>'`.
# ADMIN_PASSWORD_HASH=<salt>:<hash>

# Dev-only fallback used when ADMIN_PASSWORD_HASH is unset (ignored in production).
ADMIN_PASSWORD=admin
